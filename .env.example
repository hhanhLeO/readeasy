# PostgreSQL connection string used by Drizzle (app/lib/db/index.ts).
# Format: postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# Local Postgres credentials, used to build DATABASE_URL when running
# the database via Docker Compose. Not needed if DATABASE_URL points
# to an already-hosted database (e.g. Supabase).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Secret key used to sign/verify the JWT session cookie (app/lib/auth/session.ts).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# OAuth 2.0 credentials from the Google Cloud Console, used for
# "Sign in with Google" (app/lib/auth/google.ts). The authorized
# redirect URI must match app/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API key for the LLM provider used to generate context-aware word
# meanings (app/lib/llm/lookup.ts) and sentence/paragraph translations
# (app/lib/llm/translate.ts).
OPENAI_API_KEY=

# Max LLM calls (word lookup + translation combined) a single user can
# make per calendar day (app/lib/llm/quota.ts). Defaults to 5 if unset.
DAILY_LLM_CALL_LIMIT=
